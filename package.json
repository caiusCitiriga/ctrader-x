{
    "name": "ctrader-x",
    "version": "0.4.1",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=18"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/caiusCitiriga/ctrader-x.git"
    },
    "bugs": {
        "url": "https://github.com/caiusCitiriga/ctrader-x/issues"
    },
    "homepage": "https://github.com/caiusCitiriga/ctrader-x#readme",
    "scripts": {
        "prepare": "tsc && husky",
        "build": "tsc",
        "watch": "tsc --watch",
        "start:prod": "node dist/example/example.js",
        "start": "ts-node src/example/example.ts",
        "start:market-data": "ts-node src/example/market-data-example.ts",
        "start:trading": "ts-node src/example/trading-example.ts",
        "start:trendbars": "ts-node src/example/trendbars-example.ts",
        "start:account": "ts-node src/example/account-example.ts",
        "start:history": "ts-node src/example/history-example.ts",
        "start:streaming": "ts-node src/example/streaming-example.ts",
        "start:position-stops": "ts-node src/example/position-stops-example.ts",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:watch": "vitest",
        "generate:types": "grpc_tools_node_protoc --plugin=protoc-gen-ts_proto=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=./src/types/generated --ts_proto_opt=esModuleInterop=true,outputServices=none,useOptionals=messages,unrecognizedEnum=false -I proto proto/OpenApiCommonModelMessages.proto proto/OpenApiCommonMessages.proto proto/OpenApiModelMessages.proto proto/OpenApiMessages.proto"
    },
    "keywords": [
        "cTrader",
        "broker",
        "trading",
        "spotware"
    ],
    "author": "Caius Citiriga",
    "license": "MIT",
    "description": "Robust cTrader client, with a friendly API",
    "devDependencies": {
        "@types/node": "^20.19.43",
        "grpc-tools": "^1.13.0",
        "husky": "^9.1.7",
        "prettier": "^3.5.3",
        "pretty-quick": "^4.1.1",
        "ts-node": "^10.9.2",
        "ts-proto": "^2.6.1",
        "typescript": "^5.8.3",
        "vitest": "^3.1.1"
    },
    "dependencies": {
        "@bufbuild/protobuf": "^2.2.5",
        "dotenv": "^16.4.7"
    }
}
